#!/bin/sh
#
# 공개 레포에 들어가면 안 되는 것이 스테이징됐을 때 커밋을 막는다.
#
# 설치: 각 컴퓨터에서 한 번씩
#   git config core.hooksPath scripts/hooks
#
# 배경: 2026-09-20 f29003e 에서 git add -A 로 포트폴리오 97개가 공개 레포에
# 올라갔고, 이력서의 전화번호도 같은 방식으로 새어 나갔다. 두 번 다 filter-repo
# 로 히스토리를 고쳤지만 옛 커밋 SHA 로는 여전히 읽힌다. 되돌릴 수 없는 사고라
# 사전에 막는 쪽이 유일한 대책이다.

fail=0

note() {
	if [ "$fail" -eq 0 ]; then
		echo ""
		echo "커밋을 중단했습니다. 공개 레포에 들어가면 안 되는 것이 있습니다."
		echo ""
	fi
	fail=1
	echo "  $1"
}

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. 경로 자체가 금지인 것
for f in $staged; do
	case "$f" in
		CLAUDE.md|CLAUDE.local.md|AGENTS.md|AGENTS.local.md|Codex.md|Codex.local.md|GEMINI.md)
			note "$f  (에이전트 로컬 컨텍스트)" ;;
		output/*|tmp/*)
			note "$f  (작업 산출물)" ;;
		.env.local|*/.env.local)
			note "$f  (로컬 비밀값)" ;;
		content/drafts|content/drafts/*)
			# 중첩 git 레포를 실수로 add 하면 하위 파일이 아니라
			# 폴더 이름 그대로(gitlink) 스테이징된다. 둘 다 잡는다.
			note "$f  (비공개 초고)" ;;
	esac
done

# 2. 내용이 금지인 것. 워킹트리가 아니라 스테이징된 내용을 본다.
for f in $staged; do
	case "$f" in
		*.md) ;;
		*) continue ;;
	esac

	blob=$(git show ":$f" 2>/dev/null) || continue

	# 집필 메모는 본문에서만 의미가 있다. docs/ 처럼 이 규칙 자체를
	# 설명하는 문서가 걸리지 않도록 content/ 아래로 좁힌다.
	case "$f" in
		content/*)
			if printf '%s' "$blob" | grep -q '집필 메모'; then
				note "$f  (집필 메모 주석이 남아 있음. 발행 전에 지울 것)"
			fi ;;
	esac

	if printf '%s' "$blob" | grep -Eq '01[016-9][-. ]?[0-9]{3,4}[-. ]?[0-9]{4}'; then
		note "$f  (전화번호로 보이는 문자열)"
	fi
done

if [ "$fail" -ne 0 ]; then
	echo ""
	echo "고친 뒤 다시 커밋하세요. 의도한 것이 확실하다면 git commit --no-verify 로"
	echo "건너뛸 수 있지만, 공개 레포라 되돌릴 수 없다는 점을 기억하세요."
	echo ""
	exit 1
fi

exit 0
